rules_version = '2';
// Answer Arcade security rules. Paste this whole file into
// Firebase console -> Firestore Database -> Rules, then click Publish.
// Put every teacher Google account that may use the dashboard in the list below
// (lowercase), and keep it the same as TEACHER_EMAILS in js/firebase-config.js.
service cloud.firestore {
  match /databases/{database}/documents {

    function isTeacher() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'r.miranda@ascensionoakpark.com'
        ];
    }
    function classExists(code) {
      return code is string && exists(/databases/$(database)/documents/classes/$(code));
    }
    function goodScore(n) { return n is int && n >= 0 && n < 10000000; }

    // Question sets. Anyone using the arcade can see the list and open a set (no sign-in needed).
    // Only teachers can create, change or delete them.
    match /classes/{code} {
      allow get, list: if true;
      allow create, update, delete: if isTeacher();
    }

    // Question pictures. Everyone can see them; only teachers can add or remove them.
    match /images/{imageId} {
      allow read: if true;
      allow create: if isTeacher() && request.resource.data.keys().hasOnly(['code','data'])
        && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
      allow update, delete: if isTeacher();
    }

    // One document per finished run (student progress). Students can only add, never read or change.
    // Only teachers can read progress.
    match /runs/{runId} {
      allow create: if request.resource.data.keys().hasOnly(['code','name','nameKey','game','score','right','wrong','answers','endedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 24
        && request.resource.data.nameKey is string && request.resource.data.nameKey.size() <= 24
        && request.resource.data.game is string && request.resource.data.game.size() <= 12
        && goodScore(request.resource.data.score)
        && request.resource.data.right is int && request.resource.data.wrong is int
        && request.resource.data.answers is list && request.resource.data.answers.size() <= 300
        && request.resource.data.endedAt == request.time
        && classExists(request.resource.data.code);
      allow read, delete: if isTeacher();
      allow update: if false;
    }

    // Best score per student per game per question set. Everyone can read it.
    // An entry can only go up, and its id must match its contents.
    match /leaderboard/{entryId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['code','game','name','nameKey','best','updatedAt'])
        && entryId == request.resource.data.code + '_' + request.resource.data.game + '_' + request.resource.data.nameKey
        && request.resource.data.game is string && request.resource.data.game.size() <= 12
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && goodScore(request.resource.data.best)
        && classExists(request.resource.data.code);
      allow update: if request.resource.data.keys().hasOnly(['code','game','name','nameKey','best','updatedAt'])
        && request.resource.data.code == resource.data.code
        && request.resource.data.game == resource.data.game
        && request.resource.data.nameKey == resource.data.nameKey
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && goodScore(request.resource.data.best)
        && request.resource.data.best > resource.data.best;
      allow delete: if isTeacher();
    }
  }
}
